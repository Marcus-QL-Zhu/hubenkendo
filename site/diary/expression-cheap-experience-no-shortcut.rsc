ria-current":"$undefined","children":"联系到馆"}]]}]]}]]}],["$","header",null,{"className":"diary-article-header","children":["$","div",null,{"className":"page-shell","children":[["$","nav",null,{"className":"diary-breadcrumb","aria-label":"面包屑","children":[["$","$L6",null,{"href":"/","children":"首页"}],["$","span",null,{"children":"/"}],["$","$L6",null,{"href":"/diary","children":"剑道日记"}],["$","span",null,{"children":"/"}],["$","strong",null,{"children":"表达越来越便宜，体验依然没有捷径"}]]}],["$","div",null,{"className":"diary-article-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"剑道日记 / JOURNAL"}],["$","h1",null,{"children":"表达越来越便宜，体验依然没有捷径"}],["$","p",null,{"className":"diary-article-summary","children":"从一记拔击胴谈到合同谈判，再谈 AI 可以解释道理，却不能替人承受经验变成身体判断的过程。"}],["$","div",null,{"className":"diary-article-meta","children":[["$","span",null,{"children":"2026-09-21"}],["$","span",null,{"children":"虎贲馆会员"}],[["$","span","AI",{"children":"AI"}],["$","span","体验",{"children":"体验"}],["$","span","剑道",{"children":"剑道"}],["$","span","拔击胴",{"children":"拔击胴"}],["$","span","悬待",{"children":"悬待"}],["$","span","运动的禅",{"children":"运动的禅"}]]]}]]}],null]}]]}]}],["$","article",null,{"className":"diary-article-body","children":["$","div",null,{"className":"page-shell diary-reading-shell","children":[["$","div",null,{"className":"diary-reading-label","children":[["$","span",null,{"children":"虎贲馆"}],["$","small",null,{"children":"HUBEN KENDO"}]]}],["$","div",null,{"children":[["$","div",null,{"className":"diary-content","children":[["$","h2","0",{"children":[["$","span","0",{"children":"表达越来越便宜，体验依然没有捷径"}]]}],["$","p","1",{"children":[["$","span","0",{"children":"剑道里有一个招式，叫拔击胴。书中写作“抜き胴（拨击胴）”。对手从正面打面时，练习者只用很小的距离避开来剑，同时把刀打在对手的胴上。动作拆开来看并不复杂，难点在于时机。"}]]}],["$","p","2",{"children":[["$","span","0",{"children":"在对手启动、出手、剑路逐渐确定的过程中，你要忍耐，忍耐，再忍耐。直到对手的轨迹不会再改变，才在那个极窄的时间里出手。心里一害怕，身体就会提前动。你一动，对手也会随之改变剑路，原本要打的面仍然可能打在你身上。动得太晚，则已经被击中。"}]]}],["$","p","3",{"children":[["$","span","0",{"children":"拔击胴考验的，就是这一下既不能抢先，又不能迟疑的时机。"}]]}],["$","h2","4",{"children":[["$","span","0",{"children":"从道理到身体"}]]}],["$","p","5",{"children":[["$","span","0",{"children":"这个招式我练了很多年。道理一直懂，动作却一直做得不够顺。"}]]}],["$","p","6",{"children":[["$","span","0",{"children":"2024年可以自由往返日本之后，我去了日本三重县四日市，拜访此前未曾谋面的七段的福泽纯一老师和六段的稻垣敦宣老师，和两位老师连续练习了七天。"}]]}],["$","p","7",{"children":[["$","span","0",{"children":"这七天里没有一个突然开窍的时刻。这七天更像一个渐进的过程。每天面对足够强大的对手，几乎不再期待自己一定要赢，反而能把心里的包袱放下一些，按照身体收到的要求去练。原本只停留在理解层面的东西，慢慢开始进入身体。"}]]}],["$","p","8",{"children":[["$","span","0",{"children":"我长期把问题归结为自己还缺一条更清楚的道理。理论指导和身体指导之间隔着一段只能由练习走完的路。老师可以告诉你什么时候等、怎样进，面前到来的一剑仍然要由你在压力里完成。"}]]}],["$","h2","9",{"children":[["$","span","0",{"children":"悬即待"}]]}],["$","p","10",{"children":[["$","span","0",{"children":"我最近重看我自己翻译出版的剑道书，里面谈到“悬、待”和“空”。书里有一句“悬即待”，把它解释成一种同时保留进攻和等待可能的状态。身体处在随时可以动的准备中，心却不被某一个结果牵着走。"}]]}],["$","p","11",{"children":[["$","span","0",{"children":"书中谈到胴技的要领时，用了“充满悬待之气，在无心的状态下”这样的说法。这里的“空”并不等于什么都没有。它包含判断、准备和承担后果的能力。你知道自己在等待什么，也知道自己愿意承担什么，于是身体保持可动，心不抢先。"}]]}],"$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}],"$L29"]}]]}]}],"$L2a","$L2b","$L2c","$L2d"]}]
8:["$","p","12",{"children":[["$","span","0",{"children":"看书是没办法学会骑自行车的。"}]]}]
9:["$","p","13",{"children":[["$","span","0",{"children":"书可以讲平衡、重心、方向和刹车。你读懂这些，仍然要把车推到路上，身体经历摇晃、失衡和重新找回方向的过程。剑道也有同样的部分。你可以看视频，读书，听老师解释，知道拔击胴的步骤，知道“悬待”“无心”“不动心”的含义。可一旦对手真的从面前起剑，身体会怎样反应，恐惧会提前多久出现，你能否忍耐到剑路确定，只有你自己在一次次被击中与重新出手里知道。"}]]}]
a:["$","p","14",{"children":[["$","span","0",{"children":"这些经验无法被一段说明直接交给另一个人。"}]]}]
b:["$","h2","15",{"children":[["$","span","0",{"children":"一次合同谈判"}]]}]
c:["$","p","16",{"children":[["$","span","0",{"children":"前几天，我在工作中遇到一个很像拔击胴的时刻。"}]]}]
d:["$","p","17",{"children":[["$","span","0",{"children":"团队里一名成员正在和一个大客户谈合同费率。这个客户对他很重要，他过去的升职也和这个客户有关。客户的生意越做越大，议价能力越来越强，希望供应商进一步降低费率。"}]]}]
e:["$","p","18",{"children":[["$","span","0",{"children":"他很纠结，觉得还要再谈一谈。我问他，“你的底线是多少？”"}]]}]
f:["$","p","19",{"children":[["$","span","0",{"children":"他说了一个数字。"}]]}]
10:["$","p","20",{"children":[["$","span","0",{"children":"我接着问，“那如果谈不拢这个数字，你就不做吗？”"}]]}]
11:["$","p","21",{"children":[["$","span","0",{"children":"他说，“不，这个客户肯定还是要做的。”"}]]}]
12:["$","p","22",{"children":[["$","span","0",{"children":"我说，“那你这不就相当于没有底线吗？”"}]]}]
13:["$","p","23",{"children":[["$","span","0",{"children":"他就说不出话了。"}]]}]
14:["$","p","24",{"children":[["$","span","0",{"children":"他知道谈判需要底线，也给出了一个数字。可这个数字后面还没有对应的选择。只要无论结果如何都继续接受，所谓底线就只是一个愿望。"}]]}]
15:["$","p","25",{"children":[["$","span","0",{"children":"我后来想到，谈判里有力量的状态，可以用一句话表达。"}]]}]
16:["$","p","26",{"children":[["$","span","0",{"children":"我当然想谈成，但我不怕谈不成。"}]]}]
17:["$","p","27",{"children":[["$","span","0",{"children":"“想谈成”代表你仍然在争取。“不怕谈不成”代表你手里有真实的底线，也有愿意承担的后果。两者同时存在，人才能把注意力放回对方的动作和谈判本身。你可以继续等待，也可以在时机到了的时候出手。"}]]}]
18:["$","p","28",{"children":[["$","span","0",{"children":"这个“既有又没有”的状态仍然保留目标，也允许谈不成的结果存在。它让目标和恐惧分开。你愿意争取，也接受谈不成的后果，心才有空间观察、等待和判断。"}]]}]
19:["$","p","29",{"children":[["$","span","0",{"children":"这和拔击胴很像。你当然希望打中，也当然不希望自己被打中。可若过度在意某一个结果，身体就会提前动摇。这样的“悬待”带着一个可以承受的退出可能，带着对结果的克制。"}]]}]
1a:["$","h2","30",{"children":[["$","span","0",{"children":"AI 能说明体验，却不能替你完成体验"}]]}]
1b:["$","p","31",{"children":[["$","span","0",{"children":"说到这里，AI 的边界就清楚一些了。"}]]}]
1c:["$","p","32",{"children":[["$","span","0",{"children":"现在大家都对AI既焦虑，又把AI高高捧上天。AI 可以把拔击胴拆成步骤，可以根据书里的内容解释悬待和空，也可以把合同谈判整理成底线、替代方案和让步策略。它还能根据你提供的训练记录，帮你复盘哪一次提前动了。"}]]}]
1d:["$","p","33",{"children":[["$","span","0",{"children":"这些工作很有用。它们能让表达更快，让资料更容易检索，让道理更容易被说明。"}]]}]
1e:["$","p","34",{"children":[["$","span","0",{"children":"可 AI 没有站在一刀距离之外等对手起剑，也没有在剑路逼近时忍住提前动的冲动。它没有被别人打中面，也没有在打中别人之后感受那个距离是否刚好。它可以理解这些词在文本里的关系，无法替一个具体的人把这些关系变成身体在压力里的判断。"}]]}]
1f:["$","p","35",{"children":[["$","span","0",{"children":"合同谈判也一样。AI 可以提醒你设定底线、准备替代方案、识别对方的利益结构。到了那个客户面前，那个客户曾经怎样帮助过你，你对失去他的担心如何影响你的判断，这些只能由你自己面对。文字能传递一部分，剩下的部分仍然要由本人承担。"}]]}]
20:["$","p","36",{"children":[["$","span","0",{"children":"AI 时代，表达会越来越便宜。整理、改写、翻译、解释、生成都在变快。体验依然没有捷径。身体怎样在压力中保持稳定，心怎样在想要结果时仍然保留判断，只有反复练习、承担被击中的可能、经历失败和等待，才能把它们交给你。"}]]}]
21:["$","h2","37",{"children":[["$","span","0",{"children":"剑是运动的禅"}]]}]
22:["$","p","38",{"children":[["$","span","0",{"children":"我对禅修并不特别懂。不过我知道，禅修不能由别人替你完成。剑道也要自己走进道场。"}]]}]
23:["$","p","39",{"children":[["$","span","0",{"children":"你可以听别人讲，也可以让 AI 帮你整理道理。答案会在你面对对手时，经过一段很长的、没有戏剧性捷径的练习，慢慢进入身体。"}]]}]
24:["$","p","40",{"children":[["$","span","0",{"children":"看书是没办法学会骑自行车的。看懂拔击胴，也不会自动让你在一剑面前保持住。你需要来道场，亲自被别人打中，或者打中别人；感受对手进攻的压力；在进攻时既谨慎又跃跃欲试；经历长时间看不到进步的低落，也经历在漫长练习中逐渐发现自己比过去多做对了一点的感觉。"}]]}]
25:["$","p","41",{"children":[["$","span","0",{"children":"这些东西没有办法只靠观看和阅读获得，也无法让 AI 代替你完成。"}]]}]
26:["$","p","42",{"children":[["$","span","0",{"children":"书里有一句话，剑是运动的“禅”。对我来说，这句话不要求先有一套高深的禅学解释。它只提醒我，很多道理要经过身体才会属于自己。"}]]}]
27:["$","p","43",{"children":[["$","span","0",{"children":"表达越来越便宜，体验依然没有捷径。"}]]}]
28:["$","p","44",{"children":[["$","span","0",{"children":"如果你想知道剑道到底是什么，最可靠的办法仍然是拿起竹刀，站到对手面前，开始练习。"}]]}]
29:["$","p",null,{"className":"diary-updated","children":["更新于 ","2026-09-21"]}]
2a:["$","section",null,{"className":"diary-article-cta","children":["$","div",null,{"className":"page-shell compact-cta","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"到馆 / CONTACT"}],["$","h2",null,{"children":["读完之后，",["$","br",null,{}],["$","em",null,{"children":"来练一次。"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"children":["如果你也想作为","零基础","学员接触剑道，欢迎联系","姚馆长","预约参访旁听。"]}],["$","$L6",null,{"className":"button button-primary","href":"/contact","children":["联系到馆 ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
