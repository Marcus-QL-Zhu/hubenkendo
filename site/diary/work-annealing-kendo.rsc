ria-current":"$undefined","children":"联系到馆"}]]}]]}]]}],["$","header",null,{"className":"diary-article-header","children":["$","div",null,{"className":"page-shell","children":[["$","nav",null,{"className":"diary-breadcrumb","aria-label":"面包屑","children":[["$","$L6",null,{"href":"/","children":"首页"}],["$","span",null,{"children":"/"}],["$","$L6",null,{"href":"/diary","children":"剑道日记"}],["$","span",null,{"children":"/"}],["$","strong",null,{"children":"你想要的生活，是谁替你选的"}]]}],["$","div",null,{"className":"diary-article-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"剑道日记 / JOURNAL"}],["$","h1",null,{"children":"你想要的生活，是谁替你选的"}],["$","p",null,{"className":"diary-article-summary","children":"从贪心与模拟退火谈职业选择，以及练剑中的个人体验。"}],["$","div",null,{"className":"diary-article-meta","children":[["$","span",null,{"children":"2026-11-01"}],["$","span",null,{"children":"虎贲馆会员"}],[["$","span","剑道",{"children":"剑道"}],["$","span","工作",{"children":"工作"}],["$","span","职业选择",{"children":"职业选择"}]]]}]]}],["$","figure",null,{"className":"diary-article-cover","style":{"aspectRatio":"1918 / 820","minHeight":0,"alignSelf":"center"},"children":["$","$L7",null,{"unoptimized":true,"src":"/diary-assets/20261101-001/20261101-001-b53f1e73a1e9-fc7ede02-zenshin-zenrei-plaque.png","alt":"写有全身全霊的木质横匾，AI生成配图","fill":true,"priority":true,"sizes":"(max-width: 650px) 100vw, 43vw"}]}]]}]]}]}],["$","article",null,{"className":"diary-article-body","children":["$","div",null,{"className":"page-shell diary-reading-shell","children":[["$","div",null,{"className":"diary-reading-label","children":[["$","span",null,{"children":"虎贲馆"}],["$","small",null,{"children":"HUBEN KENDO"}]]}],["$","div",null,{"children":[["$","div",null,{"className":"diary-content","children":[["$","h2","0",{"children":[["$","span","0",{"children":"你想要的生活，是谁替你选的"}]]}],["$","p","1",{"children":[["$","span","0",{"children":"最近好几个朋友来问我换工作的意见。我给他们讲了两个算法，贪心算法和退火算法。"}]]}],["$","p","2",{"children":[["$","span","0",{"children":"名字听起来有点远，其实都能用很简单的话解释。"}]]}],["$","p","3",{"children":[["$","span","0",{"children":"贪心算法，就是每走一步，都挑眼前最好的那个选择。放到换工作上，假如只看收入，就是每次都挑薪水最高的机会。"}]]}],["$","p","4",{"children":[["$","span","0",{"children":"这个办法直接，也容易执行。但眼前最好，和长期最好之间，可能差着很远。"}]]}],["$","p","5",{"children":[["$","span","0",{"children":"想象自己在山里，只允许往高处走。走到附近的一座山顶，四周都是下坡，你就停住了。这叫局部最优。更远处可能还有一座更高的山，那才是整个范围里的最高点，也就是全局最优。可要过去，你得先下山。"}]]}],["$","p","6",{"children":[["$","span","0",{"children":"如果坚持每一步都必须比上一步高，那座更高的山就去不了了。"}]]}],["$","p","7",{"children":[["$","span","0",{"children":"换工作也会遇到类似的问题。假设有个机会，眼前收入少一点，却能让你进入自己想长期做的领域。只比较下一份工资，就很容易直接把它排除。几年后会怎样，现在当然没人知道，但这个方向也就没有被认真考虑的机会。"}]]}],["$","p","8",{"children":[["$","span","0",{"children":"退火算法提供了另一种思路。"}]]}],["$","p","9",{"children":[["$","span","0",{"children":"它的全名是模拟退火算法。搜索过程中，遇到更好的选择就接受，遇到暂时更差的选择，也按一定概率接受，避免一直停在眼前这个局部最优。开始时，它更愿意尝试；随着搜索推进，接受较差选择的概率逐渐降低，慢慢收敛。"}]]}],["$","p","10",{"children":[["$","span","0",{"children":"借到职业选择上，我看重的是其中这点启发。为了探索更值得投入的方向，可以容许某些眼前条件暂时下降。至于代价能承受多少、凭什么相信值得尝试，还得自己判断。人生里的试错有成本，退火也无法保证替我们找到全局最优。"}]]}],"$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}],"$L20"]}]]}]}],"$L21","$L22","$L23","$L24"]}]
8:["$","p","11",{"children":[["$","span","0",{"children":"和我聊过的一位朋友，没过多久就决定跳槽了。至于这个决定将来会怎样，还需要时间。"}]]}]
9:["$","p","12",{"children":[["$","span","0",{"children":"聊完这些，我又想到一个更难回答的问题。"}]]}]
a:["$","p","13",{"children":[["$","span","0",{"children":"我们拿什么判断，一个选择究竟好不好？"}]]}]
b:["$","p","14",{"children":[["$","span","0",{"children":"算法里有个词，叫目标函数。可以把它理解成一套打分标准，告诉程序什么算好、什么算差。把收入设为唯一标准，程序就会努力寻找收入更高的结果。至于那份生活自己喜不喜欢，这套标准没有负责回答。"}]]}]
c:["$","p","15",{"children":[["$","span","0",{"children":"上一篇文章里，我谈过工作和人的价值。这次聊换工作，我觉得同样需要问问，我们想从工作里得到什么。"}]]}]
d:["$","p","16",{"children":[["$","span","0",{"children":"收入有一个很方便的地方，它能直接比较。自己喜欢做什么，愿意过怎样的日子，往往含糊得多。含糊的问题很难回答，容易比较的数字便成了主要依据。"}]]}]
e:["$","p","17",{"children":[["$","span","0",{"children":"而且，我们每天都在接收别人对生活的解释。各种媒体不断告诉我们，什么样的职业有前途，什么样的人算成功。工作里的考核与晋升，又给这些判断加上了现实的分量。收入关系到生活，职位影响着机会，在这样的环境里，升职加薪很容易成了一个无需解释的目标。"}]]}]
f:["$","p","18",{"children":[["$","span","0",{"children":"久而久之，连自己也很少再问，这个目标究竟涵盖了多少自己的愿望。"}]]}]
10:["$","p","19",{"children":[["$","span","0",{"children":"我觉得，一个人愿意为什么接受眼前的代价，很值得留意。如果你愿意为了某类工作少挣一点，至少说明，这件事在你心里有分量。沿着自己的取舍往下问，可能会比笼统地说“我想找份更好的工作”清楚一些。"}]]}]
11:["$","p","20",{"children":[["$","span","0",{"children":"但这也有个难处。别人的期待听得太多，我们会把它们当成自己的意愿。做选择时，连那套打分标准都已经用惯了，很难停下来检查。"}]]}]
12:["$","p","21",{"children":[["$","span","0",{"children":"这也是我想在这里谈练剑的原因。"}]]}]
13:["$","figure","22",{"children":[["$","$L7",null,{"unoptimized":true,"src":"/diary-assets/20261101-001/20261101-001-b53f1e73a1e9-fc7ede02-zenshin-zenrei-plaque.png","alt":"写有全身全霊的木质横匾，AI生成配图","width":1918,"height":820}],["$","figcaption",null,{"children":"写有全身全霊的木质横匾，AI生成配图"}]]}]
14:["$","p","23",{"children":[["$","span","0",{"children":"全日本剑道联盟刊载的大保木辉雄《剣道気論の行方》，在讨论哲学家杜尔克海姆对“肚”的理解时，谈到“全身全霊”地置身当下，以及通过姿势、呼吸等身体实践，追求身心一体的状态。"}]]}]
15:["$","p","24",{"children":[["$","span","0",{"children":"“全身全霊”，就是把全部身心投入其中。我对这几个字的理解，也与自己的练习体验有关。"}]]}]
16:["$","p","25",{"children":[["$","span","0",{"children":"两小时投入练剑，其他事情可以暂时放下。注意力集中在眼前，工作里的问题就没有一直占着脑子。有时候，反而会突然想通某个具体问题。"}]]}]
17:["$","p","26",{"children":[["$","span","0",{"children":"对我来说，这段时间的可贵之处，还在于我终于可以暂时离开那些熟悉的评价。"}]]}]
18:["$","p","27",{"children":[["$","span","0",{"children":"练剑时，我不用继续盘算月度工作计划，也不必跟着刚刷到的成功故事衡量自己。眼前有需要认真投入的练习，我愿意把身心放进去。这件事本身，就值得花上两小时。"}]]}]
19:["$","p","28",{"children":[["$","span","0",{"children":"这样的投入，给了我一个重新认识自己的机会。工作之外，原来还有事情让我愿意认真花时间。暂时放下收入和职位，我仍然有自己的感受，也有愿意持续做下去的事。"}]]}]
1a:["$","p","29",{"children":[["$","span","0",{"children":"上一篇文章谈到，工作之外也有值得认真对待的生活。再往下想，当这些生活真实地发生在自己身上，我们才有更具体的依据，去判断自己究竟看重什么。"}]]}]
1b:["$","p","30",{"children":[["$","span","0",{"children":"所以，我愿意把练剑看作正视内心的一种练习。全身心投入眼前，外界纷杂的评价暂时退开，我才有机会分辨，自己究竟喜欢什么，又有哪些追求，只是因为身边的人一直在追。"}]]}]
1c:["$","p","31",{"children":[["$","span","0",{"children":"它让我在日常的比较之外，保留一段能够认真感受自己、诚实面对自己的时间。再回去作选择时，我希望自己能够多问一句，这个决定，和我想过的生活有什么关系？"}]]}]
1d:["$","p","32",{"children":[["$","span","0",{"children":"我们正在进入一个前所未有的时代。工业革命让机器接过大量体力劳动，AI 则可能进一步把人从大量智力劳动中解放出来。当智力成为随时可以调用的廉价资源，一个人就有机会做过去需要整个团队才能完成的事。那些受限于知识和技能、一直没能动手的想法，如今都可能值得试一试。"}]]}]
1e:["$","p","33",{"children":[["$","span","0",{"children":"印刷术出现时，抄经修士也曾面对自己的工作被机器取代，然而在瑞士圣加仑修道院，发生了一件奇特的事情：修士们看待印刷机时，并没有把它视为自己的替代品，而是视为解放。几个世纪以来，他们一直是抄写员，现在他们可以成为学者。曾经用来抄写的时间可以用来思考，以抄写来制造书页的双手可以开始翻阅书页了。他们建立了欧洲首批大型图书馆，收集了那些本来被认为是他们末日的印刷书籍。他们创造了前所未有的东西：一个融合人类智慧而非简单复制的学习中心。印刷机没有摧毁他们，反而把他们变成了知识的建筑师。"}]]}]
1f:["$","p","34",{"children":[["$","span","0",{"children":"圣加仑的加布里埃尔修士（Brother Gabriel of St. Gall）在 1485 年写道：“机器夺走了我们旧有的工作。感谢上帝。现在我们可以开始真正的工作了。”"}]]}]
20:["$","p",null,{"className":"diary-updated","children":["更新于 ","2026-11-01"]}]
21:["$","section",null,{"className":"diary-article-cta","children":["$","div",null,{"className":"page-shell compact-cta","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"到馆 / CONTACT"}],["$","h2",null,{"children":["读完之后，",["$","br",null,{}],["$","em",null,{"children":"来练一次。"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"children":["如果你也想作为","零基础","学员接触剑道，欢迎联系","姚馆长","预约参访旁听。"]}],["$","$L6",null,{"className":"button button-primary","href":"/contact","children":["联系到馆 ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
22:["$","section",null,{"className":"diary-related-section","aria-labelledby":"related-title","children":["$","div",null,{"className":"page-shell","children":[["$","div",null,{"className":"diary-related-heading","children":[["$","p",null,{"className":"eyebrow","children":"继续阅读 / MORE"}],["$","h2",null,{"id":"related-title","children":"其他剑道日记"}]]}],["$","div",null,{"className":"diary-related-grid","children":[["$","$L6","ai-human-worth-kendo",{"className":"diary-related-card","href":"/diary/ai-human-worth-kendo","children":[["$","span",null,{"children":"2026-10-25"}],["$","strong",null,{"children":"如果 AI 比我更能干，我还想做什么"}],["$","small",null,{"children":"当工作越来越难以证明一个人的价值，我们还愿意为什么投入时间？从潮玩、围棋谈到剑道里的人的养成。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}],["$","$L6","uncertainty-tolerance",{"className":"diary-related-card","href":"/diary/uncertainty-tolerance","children":[["$","span",null,{"children":"2026-09-27"}],["$","strong",null,{"children":"等一条重要回复时，怎样让自己别一直悬着？"}],["$","small",null,{"children":"等重要的人迟迟没有回复，最让人难受的也许是悬着的那段时间。文章从剑道里的悬待说起，谈如何在不确定中稳住行动。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
