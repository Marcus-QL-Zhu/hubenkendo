11:["$","section",null,{"className":"diary-related-section","aria-labelledby":"related-title","children":["$","div",null,{"className":"page-shell","children":[["$","div",null,{"className":"diary-related-heading","children":[["$","p",null,{"className":"eyebrow","children":"继续阅读 / MORE"}],["$","h2",null,{"id":"related-title","children":"其他剑道日记"}]]}],["$","div",null,{"className":"diary-related-grid","children":[["$","$L6","expression-cheap-experience-no-shortcut",{"className":"diary-related-card","href":"/diary/expression-cheap-experience-no-shortcut","children":[["$","span",null,{"children":"2026-09-21"}],["$","strong",null,{"children":"表达越来越便宜，体验依然没有捷径"}],["$","small",null,{"children":"从一记拔击胴谈到合同谈判，再谈 AI 可以解释道理，却不能替人承受经验变成身体判断的过程。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}],["$","$L6","agent-kendo-diary",{"className":"diary-related-card","href":"/diary/agent-kendo-diary","children":[["$","span",null,{"children":"2026-08-09"}],["$","strong",null,{"children":"同时跑五个Agent会话以后，我去练剑道"}],["$","small",null,{"children":"一个同时跑多个 Codex 会话的上班族，记录自己为什么在高强度用脑之后去练剑。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
