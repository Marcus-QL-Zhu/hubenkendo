ria-current":"$undefined","children":"联系到馆"}]]}]]}]]}],["$","header",null,{"className":"diary-article-header","children":["$","div",null,{"className":"page-shell","children":[["$","nav",null,{"className":"diary-breadcrumb","aria-label":"面包屑","children":[["$","$L6",null,{"href":"/","children":"首页"}],["$","span",null,{"children":"/"}],["$","$L6",null,{"href":"/diary","children":"剑道日记"}],["$","span",null,{"children":"/"}],["$","strong",null,{"children":"如果 AI 比我更能干，我还想做什么"}]]}],["$","div",null,{"className":"diary-article-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"剑道日记 / JOURNAL"}],["$","h1",null,{"children":"如果 AI 比我更能干，我还想做什么"}],["$","p",null,{"className":"diary-article-summary","children":"当工作越来越难以证明一个人的价值，我们还愿意为什么投入时间？从潮玩、围棋谈到剑道里的人的养成。"}],["$","div",null,{"className":"diary-article-meta","children":[["$","span",null,{"children":"2026-10-25"}],["$","span",null,{"children":"虎贲馆会员"}],[["$","span","AI",{"children":"AI"}],["$","span","剑道文化",{"children":"剑道文化"}],["$","span","人間形成",{"children":"人間形成"}]]]}]]}],null]}]]}]}],["$","article",null,{"className":"diary-article-body","children":["$","div",null,{"className":"page-shell diary-reading-shell","children":[["$","div",null,{"className":"diary-reading-label","children":[["$","span",null,{"children":"虎贲馆"}],["$","small",null,{"children":"HUBEN KENDO"}]]}],["$","div",null,{"children":[["$","div",null,{"className":"diary-content","children":[["$","p","0",{"children":[["$","span","0",{"children":"去年 Labubu 很火的时候，围绕它有一个反复出现的问题，这东西到底有什么用？"}]]}],["$","p","1",{"children":[["$","span","0",{"children":"一只玩偶，不能帮人做家务，也不能替人处理工作。喜欢它的人，仍然愿意把它带回家。"}]]}],["$","p","2",{"children":[["$","span","0",{"children":"泡泡玛特创始人王宁在2023年的一次分享里，提过一个挺有意思的设问。假如 MOLLY 娃娃的头拔下来是个 U 盘，大家还会不会买那么多？加上功能，人可能就会开始盘算，自己已经有几个 U 盘了，还需不需要再买一个。"}]]}],["$","p","3",{"children":[["$","span","0",{"children":"这个例子让我想到，我们很容易接受一个娃娃可以没什么用。可轮到自己，往往就没这么宽容了。"}]]}],["$","p","4",{"children":[["$","span","0",{"children":"做一件事，总要问问能带来什么。学点东西，最好对工作有帮助。连休息，有时也得解释成恢复精力，好让自己明天继续干活。"}]]}],["$","p","5",{"children":[["$","span","0",{"children":"如果有一天，AI 连活儿都比我们干得好了呢？"}]]}],["$","h2","6",{"children":[["$","span","0",{"children":"工作还给了我们什么"}]]}],["$","p","7",{"children":[["$","span","0",{"children":"Stability AI的创始人Emad Mostaque 在《The Last Economy》里谈到，工作同时提供了好几样东西。收入之外，它给人身份和同事，也让人觉得自己有所贡献，给每天的生活安排节奏。"}]]}],["$","p","8",{"children":[["$","span","0",{"children":"这能解释一部分面对 AI 的不安。自己花了很多年学会的本领，如果机器做得更快、更便宜，受影响的还有那个熟悉的自我介绍，以及过去靠它获得的认可。"}]]}],["$","p","9",{"children":[["$","span","0",{"children":"工业化让机器承担了大量体力劳动，AI 又开始承担一部分脑力任务。变化会走到哪一步，现在没人能给出确定答案。但我们已经需要面对一个问题，工作在市场上能卖多少钱，与一个人怎样理解自己，究竟应该有多大的关系？"}]]}],["$","p","10",{"children":[["$","span","0",{"children":"马克思在《1844年经济学哲学手稿》中讨论过异化劳动。人无法支配自己的劳动过程和成果，劳动成为维持生活的外在手段。这种人与自身活动的疏离，离今天的生活并不遥远。"}]]}],["$","p","11",{"children":[["$","span","0",{"children":"AI 带来的变化，迫使我们这一代人从所未有地重新考虑工作和人的关系。一些过去必须由人完成的任务，将来可能无需再耗费那么多人力。可一个人愿意如何生活，仍然需要由他自己回答。"}]]}],"$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24"]}]]}]}],"$L25","$L26","$L27","$L28"]}]
8:["$","p","12",{"children":[["$","span","0",{"children":"这中间当然会有痛苦。失去收入的人，首先要解决生活问题。技术省下来的时间和创造的收益，怎样分配给人，也需要制度安排。自由不会随着软件升级自动到来。"}]]}]
9:["$","p","13",{"children":[["$","span","0",{"children":"我们可以一边认真谋生，一边提前想想，在工作之外，自己还愿意把时间花在哪里——按照Emad的预测，距离这一天真的来临也许只有不到1000天了。"}]]}]
a:["$","h2","14",{"children":[["$","span","0",{"children":"机器赢了，人还下不下棋"}]]}]
b:["$","p","15",{"children":[["$","span","0",{"children":"围棋已经经历过一次这样的变化。"}]]}]
c:["$","p","16",{"children":[["$","span","0",{"children":"2017年，柯洁与 AlphaGo 对弈告负。但他的人类棋手生涯继续向前。同年，他在人机大战之后取得了正式比赛22连胜，还拿到了全运会围棋专业组男子个人冠军。"}]]}]
d:["$","p","17",{"children":[["$","span","0",{"children":"机器的水平超过了人，人与人的比赛仍然有胜负，棋手仍然有值得研究的棋局。"}]]}]
e:["$","p","18",{"children":[["$","span","0",{"children":"对普通爱好者来说，这个问题还可以问得更直接一点。我们原本就下不过柯洁，难道在 AlphaGo 出现以前，自己的每一盘棋都白下了吗？一盘棋可以为了争胜，也可以因为自己就喜欢琢磨。喜欢这件事，并不以拥有世界最高水平为前提。"}]]}]
f:["$","h2","19",{"children":[["$","span","0",{"children":"练剑到底在练什么"}]]}]
10:["$","p","20",{"children":[["$","span","0",{"children":"现代人练剑道，通常无需靠剑术谋生，也无需靠它解决日常冲突。从这些直接用途看，我们花时间练的，确实是一件很“没用”的事。"}]]}]
11:["$","p","21",{"children":[["$","span","0",{"children":"可剑道对自己要做什么，早就有一个清楚的说法。"}]]}]
12:["$","p","22",{"children":[["$","span","0",{"children":"全日本剑道联盟在1975年制定的《剑道的理念》中，有这样一句话。"}]]}]
13:["$","p","23",{"children":[["$","strong","0",{"children":[["$","span","0",{"children":"剣道は剣の理法の修錬による人間形成の道である"}]]}]]}]
14:["$","p","24",{"children":[["$","span","0",{"children":"大意是，通过剑之理法的修炼，走向人的养成。"}]]}]
15:["$","p","25",{"children":[["$","span","0",{"children":"这里的关键词是“人間形成”。同一份理念所谈的修炼心态，还包括礼节、信义和不断自我修养。"}]]}]
16:["$","p","26",{"children":[["$","span","0",{"children":"剑道保留着明确的胜负。站到对手面前，当然要认真争取打中。也正因为想赢，练习才会让人碰到一些很具体的问题。"}]]}]
17:["$","p","27",{"children":[["$","span","0",{"children":"输了以后，能不能好好对待对手？总在同一个地方犯错时，愿不愿意承认自己的问题，再从基本动作练起？"}]]}]
18:["$","p","28",{"children":[["$","span","0",{"children":"这些问题都得放到自己身上。道理可以听懂，做起来却未必容易。一次练习没有做好，下次还可以再来。"}]]}]
19:["$","p","29",{"children":[["$","span","0",{"children":"“人間形成”说的是一条可以持续实践的路。它没有保证，练剑的人就一定比别人修养更好。礼节写在理念里，仍然要由每个练习者在面对别人时做出来。"}]]}]
1a:["$","p","30",{"children":[["$","span","0",{"children":"我觉得，这样的练习，对 AI 时代的人有一种很直接的启发。"}]]}]
1b:["$","p","31",{"children":[["$","span","0",{"children":"我们不必等到自己的工作受到冲击，才开始寻找别的生活。现在就可以在一周里留一点时间，去练一项自己愿意练的东西，认识工作之外的人。收入发生变化时，这些经验和关系或许能让人更清楚，自己的生活还包含什么。"}]]}]
1c:["$","p","32",{"children":[["$","span","0",{"children":"剑道只是其中一种选择。有人喜欢画画，有人愿意认真下棋。至于我，我愿意把这个问题放到剑道里去想，因为它把“怎样成为一个人”写进了自己的理念，也要求练习者通过行动去面对它。"}]]}]
1d:["$","h2","33",{"children":[["$","span","0",{"children":"先找一件自己愿意做的事"}]]}]
1e:["$","p","34",{"children":[["$","span","0",{"children":"如果暂时放下钱的考虑，我还想做什么？"}]]}]
1f:["$","p","35",{"children":[["$","span","0",{"children":"这个问题可以很大，也可以从很小的地方回答。没有人付钱，没有工作上的回报，我是否仍然愿意拿起竹刀，花一个晚上练习？"}]]}]
20:["$","p","36",{"children":[["$","span","0",{"children":"也不用立刻给出一个高尚的理由。"}]]}]
21:["$","p","37",{"children":[["$","span","0",{"children":"如果每次练习都必须证明自己进步了多少、人格完善了多少，爱好也会变成另一份需要交差的工作。来练剑，可以先因为好奇，因为觉得有意思。练得久了，再慢慢知道自己愿意留下来，是为了什么。"}]]}]
22:["$","p","38",{"children":[["$","span","0",{"children":"我希望 AI 能让人少做一些不得不做的事。至于省下来的时间，我们可以开始学着自己安排。赚钱仍然重要，工作之外也可以有值得认真对待的生活。"}]]}]
23:["$","p","39",{"children":[["$","span","0",{"children":"你不必先想清楚人生的意义，才来练剑。"}]]}]
24:["$","p",null,{"className":"diary-updated","children":["更新于 ","2026-10-25"]}]
25:["$","section",null,{"className":"diary-article-cta","children":["$","div",null,{"className":"page-shell compact-cta","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"到馆 / CONTACT"}],["$","h2",null,{"children":["读完之后，",["$","br",null,{}],["$","em",null,{"children":"来练一次。"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"children":["如果你也想作为","零基础","学员接触剑道，欢迎联系","姚馆长","预约参访旁听。"]}],["$","$L6",null,{"className":"button button-primary","href":"/contact","children":["联系到馆 ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
26:["$","section",null,{"className":"diary-related-section","aria-labelledby":"related-title","children":["$","div",null,{"className":"page-shell","children":[["$","div",null,{"className":"diary-related-heading","children":[["$","p",null,{"className":"eyebrow","children":"继续阅读 / MORE"}],["$","h2",null,{"id":"related-title","children":"其他剑道日记"}]]}],["$","div",null,{"className":"diary-related-grid","children":[["$","$L6","uncertainty-tolerance",{"className":"diary-related-card","href":"/diary/uncertainty-tolerance","children":[["$","span",null,{"children":"2026-09-27"}],["$","strong",null,{"children":"等一条重要回复时，怎样让自己别一直悬着？"}],["$","small",null,{"children":"等重要的人迟迟没有回复，最让人难受的也许是悬着的那段时间。文章从剑道里的悬待说起，谈如何在不确定中稳住行动。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}],["$","$L6","expression-cheap-experience-no-shortcut",{"className":"diary-related-card","href":"/diary/expression-cheap-experience-no-shortcut","children":[["$","span",null,{"children":"2026-09-21"}],["$","strong",null,{"children":"表达越来越便宜，体验依然没有捷径"}],["$","small",null,{"children":"从一记拔击胴谈到合同谈判，再谈 AI 可以解释道理，却不能替人承受经验变成身体判断的过程。"}],["$","i",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]}]
27:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"如果 AI 比我更能干，我还想做什么\",\"description\":\"当工作越来越难以证明一个人的价值，我们还愿意为什么投入时间？从潮玩、围棋谈到剑道里的人的养成。\",\"datePublished\":\"2026-10-25\",\"dateModified\":\"2026-10-25\",\"author\":{\"@type\":\"Person\",\"name\":\"虎贲馆会员\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"剑道虎贲馆\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://hubenkendo.cn/diary/ai-human-worth-kendo\"}}"}}]
